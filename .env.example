# ============================================================
# Financial Orchestrator - ornek ortam degiskenleri
# Kullanim: cp .env.example .env  (sonra degerleri doldurun)
# Bu dosya commit edilir; GERCEK .env commit EDILMEZ.
# ============================================================

# --- Veritabani ---
# Docker Compose kullaniyorsaniz asagidaki POSTGRES_* degerleri db servisini besler.
POSTGRES_USER=finorch
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=finorch
# Lokal (Docker'siz) calisirken host'u localhost yapin; Docker'da compose "db" host'unu enjekte eder.
DATABASE_URL=postgresql+psycopg://finorch:change_me_please@localhost:5432/finorch

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Telegram (bildirimler) ---
# @BotFather'dan token alin; chat id icin "finorch get-chat-id"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Whisper (yerel transkripsiyon; yalniz altyazi yoksa calisir) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Vision (cok-modlu gorsel okuma) ---
VISION_ENABLED=true
VISION_MODEL=gpt-4o-mini
# ffmpeg sahne degisimi esigi (0..1) - dusuk = daha cok kare
YT_FRAME_SCENE_THRESHOLD=0.4
# Video basina maksimum kare (maliyet siniri)
YT_MAX_FRAMES=12

# --- X / Twitter (burner hesap cookie'leri; ANA HESABINIZI KULLANMAYIN) ---
X_AUTH_TOKEN=
X_CT0=
X_USERNAME=

# --- Genel ---
DATA_DIR=./data
POLL_INTERVAL_MINUTES=30
ANALYSTS_CONFIG=./config/analysts.yaml
LOG_LEVEL=INFO

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
