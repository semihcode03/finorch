# ============================================================
# Financial Orchestrator - ornek ortam degiskenleri
# Kullanim: cp .env.example .env  (sonra degerleri doldurun)
# Bu dosya commit edilir; GERCEK .env commit EDILMEZ.
# ============================================================

# --- Veritabani ---
# Docker Compose kullaniyorsaniz asagidaki POSTGRES_* degerleri db servisini besler.
POSTGRES_USER=finorch
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=finorch
# Lokal (Docker'siz) calisirken host'u localhost yapin; Docker'da compose "db" host'unu enjekte eder.
DATABASE_URL=postgresql+psycopg://finorch:change_me_please@localhost:5432/finorch

# --- OpenAI ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# --- Telegram (bildirimler) ---
# @BotFather'dan token alin; chat id icin "finorch get-chat-id"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Whisper (yerel transkripsiyon; yalniz altyazi yoksa calisir) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Vision (cok-modlu gorsel okuma) ---
VISION_ENABLED=true
VISION_MODEL=gpt-4o-mini
# ffmpeg sahne degisimi esigi (0..1) - dusuk = daha cok kare
YT_FRAME_SCENE_THRESHOLD=0.4
# Video basina maksimum kare (maliyet siniri)
YT_MAX_FRAMES=12

# --- X / Twitter (burner hesap cookie'leri; ANA HESABINIZI KULLANMAYIN) ---
# Cookie'leri almak icin: burner hesapla x.com'a girin -> F12 -> Application ->
# Cookies -> x.com -> "auth_token" ve "ct0" degerlerini kopyalayin.
X_AUTH_TOKEN=
X_CT0=
X_USERNAME=
# Ana sayfadaki repost'lar (baskasinin gonderileri) analiz edilsin mi?
# false = yalniz analistin kendi sesi (kendi gonderisi, alintili yorumu, thread'i)
X_INCLUDE_REPOSTS=false
# Baskasina verilen kisa cevaplar genelde analiz icermez
X_INCLUDE_REPLIES=false
# Bu esigin altinda etkilesim (begeni+repost+cevap) alan gonderiler atlanir; 0 = filtre yok
X_MIN_ENGAGEMENT=0
# Ayni thread'deki gonderileri tek bir icerik olarak birlestir
X_STITCH_THREADS=true

# --- Piyasa verisi (canli fiyat + kosul takibi) ---
MARKET_ENABLED=true
# Ayni sembol icin fiyat sorgusu onbellek suresi (saniye)
MARKET_CACHE_TTL_SEC=300
# Gecmis mumlar bu sure boyunca tazelenmez (saat)
MARKET_HISTORY_TTL_HOURS=6
# Kosula "yaklasma" bandi (%): tetik fiyatina bu kadar uzaklik ilerleme=0 sayilir
WATCH_BAND_PCT=10
# Bu kadar gun tetiklenmeyen izlemeler "suresi doldu" olur
WATCH_EXPIRE_DAYS=90
# BIST sembolleri icin Yahoo Finance soneki
BIST_SUFFIX=.IS

# --- Kayan piyasa seridi (dashboard ustundeki bant) ---
TICKER_ENABLED=true
# Seritteki semboller: "sembol|etiket" ciftleri, virgulle ayrilmis.
# Bos birakilirsa varsayilan liste kullanilir (BIST, doviz, altin, emtia,
# kripto, ABD endeksleri). Ornek:
# TICKER_SYMBOLS=XU100.IS|BIST 100,USDTRY=X|USD/TRY,GRAMALTIN|Gram Altin
TICKER_SYMBOLS=
# Serit verisi kac dakikada bir cekilsin (scheduler isi)
TICKER_REFRESH_MINUTES=5
# Tarayici seridi kac saniyede bir yeniden ceksin
TICKER_POLL_SECONDS=60

# --- Efloud BTC 15dk teyit takipcisi ---
EFLOUD_SIGNAL_ENABLED=true
EFLOUD_SIGNAL_REFRESH_MINUTES=5
EFLOUD_BTC_SUPPORT=76400
EFLOUD_BTC_INVALIDATION=76000
EFLOUD_BTC_DOWNSIDE_TARGET=72500
EFLOUD_BTC_RECLAIM=82300
EFLOUD_ZONE_PCT=0.35

# --- Genel ---
DATA_DIR=./data
POLL_INTERVAL_MINUTES=30
ANALYSTS_CONFIG=./config/analysts.yaml
LOG_LEVEL=INFO

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
